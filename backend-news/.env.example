# PostgreSQL credentials. Use URL-encoded reserved characters in DATABASE_URL.
POSTGRES_USER=newshub
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=news_db
DATABASE_URL=postgresql+psycopg://newshub:replace_with_a_strong_password@localhost:5432/news_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080

# Separate multiple frontend origins with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Optional image storage. Required for dashboard image uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
